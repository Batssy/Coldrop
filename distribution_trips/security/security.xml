<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_distribution_trips" model="ir.module.category">
    <field name="name">Broadspace / Distribution Trips</field>
    <field name="sequence">55</field>
  </record>
  <record id="privilege_module_category_distribution_trips" model="res.groups.privilege">
    <field name="name">Broadspace / Distribution Trips</field>
    <field name="category_id" ref="module_category_distribution_trips" />
  </record>
  <record id="group_distribution_trips_user" model="res.groups">
    <field name="name">User / Initiator</field>
    <field name="privilege_id" ref="privilege_module_category_distribution_trips" />
  </record>
  <record id="group_distribution_trips_reviewer" model="res.groups">
    <field name="name">Reviewer</field>
    <field name="privilege_id" ref="privilege_module_category_distribution_trips" />
    <field name="implied_ids" eval="[(4, ref('group_distribution_trips_user'))]" />
  </record>
  <record id="group_distribution_trips_approver" model="res.groups">
    <field name="name">Final Approver</field>
    <field name="privilege_id" ref="privilege_module_category_distribution_trips" />
    <field name="implied_ids" eval="[(4, ref('group_distribution_trips_reviewer'))]" />
  </record>
  <record id="group_distribution_trips_manager" model="res.groups">
    <field name="name">Manager / Administrator</field>
    <field name="privilege_id" ref="privilege_module_category_distribution_trips" />
    <field name="implied_ids" eval="[(4, ref('group_distribution_trips_approver'))]" />
  </record>
</odoo>