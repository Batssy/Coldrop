<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_non_core_business" model="ir.module.category">
    <field name="name">Broadspace / Non-Core Business</field>
    <field name="sequence">55</field>
  </record>
  <record id="privilege_module_category_non_core_business" model="res.groups.privilege">
    <field name="name">Broadspace / Non-Core Business</field>
    <field name="category_id" ref="module_category_non_core_business" />
  </record>
  <record id="group_non_core_business_user" model="res.groups">
    <field name="name">User / Initiator</field>
    <field name="privilege_id" ref="privilege_module_category_non_core_business" />
  </record>
  <record id="group_non_core_business_reviewer" model="res.groups">
    <field name="name">Reviewer</field>
    <field name="privilege_id" ref="privilege_module_category_non_core_business" />
    <field name="implied_ids" eval="[(4, ref('group_non_core_business_user'))]" />
  </record>
  <record id="group_non_core_business_approver" model="res.groups">
    <field name="name">Final Approver</field>
    <field name="privilege_id" ref="privilege_module_category_non_core_business" />
    <field name="implied_ids" eval="[(4, ref('group_non_core_business_reviewer'))]" />
  </record>
  <record id="group_non_core_business_manager" model="res.groups">
    <field name="name">Manager / Administrator</field>
    <field name="privilege_id" ref="privilege_module_category_non_core_business" />
    <field name="implied_ids" eval="[(4, ref('group_non_core_business_approver'))]" />
  </record>
</odoo>