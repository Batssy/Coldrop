<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_distribution_operational_report" model="ir.actions.report"><field name="name">Distribution Operational Report</field><field name="model">distribution.operational.report.wizard</field><field name="report_type">qweb-pdf</field><field name="report_name">distribution_reporting.report_distribution_operational</field><field name="report_file">distribution_reporting.report_distribution_operational</field><field name="print_report_name">'Distribution - %s' % object.process_model</field></record>
  <template id="report_distribution_operational"><t t-call="web.html_container"><t t-foreach="docs" t-as="wizard"><t t-call="web.external_layout"><div class="page"><h2>Distribution Operational and Audit Report</h2><p><strong>Module:</strong> <span t-out="dict(wizard._fields['process_model'].selection).get(wizard.process_model)"/> | <strong>Site:</strong> <span t-out="wizard.site_id.display_name or 'All sites'"/> | <strong>Period:</strong> <span t-out="wizard.date_from or 'Open'"/> to <span t-out="wizard.date_to or 'Open'"/></p><table class="table table-sm"><thead><tr><th>Reference</th><th>Date</th><th>State</th><th>Site</th><th>Initiator</th><th>Reviewer</th><th>Approver</th><th class="text-end">Amount</th><th>Events</th><th>Latest Event</th></tr></thead><tbody><tr t-foreach="wizard.report_rows()" t-as="row"><td t-out="row['name']"/><td t-out="row['date']"/><td t-out="row['state']"/><td t-out="row['site']"/><td t-out="row['initiator']"/><td t-out="row['reviewer']"/><td t-out="row['approver']"/><td class="text-end"><span t-out="row['amount']"/> <span t-out="row['currency']"/></td><td t-out="row['event_count']"/><td t-out="row['latest_event'] or ''"/></tr></tbody></table><t t-if="wizard.include_event_details"><h3>Detailed Audit Events</h3><t t-foreach="wizard.report_rows()" t-as="row"><h4 t-out="row['name']"/><table class="table table-sm"><thead><tr><th>Timestamp</th><th>User</th><th>Action</th><th>From</th><th>To</th><th>Note</th></tr></thead><tbody><tr t-foreach="row['events']" t-as="event"><td t-out="event.event_at"/><td t-out="event.user_id.display_name"/><td t-out="event.action"/><td t-out="event.from_state"/><td t-out="event.to_state"/><td t-out="event.note or ''"/></tr></tbody></table></t></t></div></t></t></t></template>
</odoo>
