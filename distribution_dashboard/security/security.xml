<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_dashboard" model="ir.module.category">
    <field name="name">Broadspace / Distribution Control Tower</field>
    <field name="sequence">90</field>
  </record>
  <record id="privilege_module_category_dashboard" model="res.groups.privilege">
    <field name="name">Broadspace / Distribution Control Tower</field>
    <field name="category_id" ref="module_category_dashboard" />
  </record>
  <record id="group_dashboard_global_viewer" model="res.groups">
    <field name="name">Global Dashboard Viewer (Read Only)</field>
    <field name="privilege_id" ref="privilege_module_category_dashboard" />
  </record>
  <record id="group_dashboard_manager" model="res.groups">
    <field name="name">Dashboard Administrator</field>
    <field name="privilege_id" ref="privilege_module_category_dashboard" />
    <field name="implied_ids" eval="[(4,ref('group_dashboard_global_viewer'))]" />
  </record>
</odoo>