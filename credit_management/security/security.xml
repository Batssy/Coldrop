<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_credit_management" model="ir.module.category">
    <field name="name">Broadspace / Credit Management</field>
    <field name="sequence">55</field>
  </record>
  <record id="privilege_module_category_credit_management" model="res.groups.privilege">
    <field name="name">Broadspace / Credit Management</field>
    <field name="category_id" ref="module_category_credit_management" />
  </record>
  <record id="group_credit_management_user" model="res.groups">
    <field name="name">User / Initiator</field>
    <field name="privilege_id" ref="privilege_module_category_credit_management" />
  </record>
  <record id="group_credit_management_reviewer" model="res.groups">
    <field name="name">Reviewer</field>
    <field name="privilege_id" ref="privilege_module_category_credit_management" />
    <field name="implied_ids" eval="[(4, ref('group_credit_management_user'))]" />
  </record>
  <record id="group_credit_management_approver" model="res.groups">
    <field name="name">Final Approver</field>
    <field name="privilege_id" ref="privilege_module_category_credit_management" />
    <field name="implied_ids" eval="[(4, ref('group_credit_management_reviewer'))]" />
  </record>
  <record id="group_credit_management_manager" model="res.groups">
    <field name="name">Manager / Administrator</field>
    <field name="privilege_id" ref="privilege_module_category_credit_management" />
    <field name="implied_ids" eval="[(4, ref('group_credit_management_approver'))]" />
  </record>
</odoo>