<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <!-- Access for the demo users -->
  <record id="distribution_core.demo_user_initiator" model="res.users">
    <field name="group_ids" eval="[(4, ref('purchase_commitment_control.group_purchase_commitment_control_user'))]"/>
  </record>
  <record id="distribution_core.demo_user_reviewer" model="res.users">
    <field name="group_ids" eval="[(4, ref('purchase_commitment_control.group_purchase_commitment_control_reviewer'))]"/>
  </record>
  <record id="distribution_core.demo_user_approver" model="res.users">
    <field name="group_ids" eval="[(4, ref('purchase_commitment_control.group_purchase_commitment_control_approver'))]"/>
  </record>
  <record id="workflow_approval.demo_user_senior_approver" model="res.users">
    <field name="group_ids" eval="[(4, ref('purchase_commitment_control.group_purchase_commitment_control_approver'))]"/>
  </record>
  <record id="workflow_approval.demo_user_workflow_manager" model="res.users">
    <field name="group_ids" eval="[(4, ref('purchase_commitment_control.group_purchase_commitment_control_manager'))]"/>
  </record>

  <!-- Quarterly supplier commitment (high value): approved, with a call-off already converted to an RFQ -->
  <record id="demo_pc_coastal_quarter" model="purchase.commitment" uid="distribution_core.demo_user_initiator">
    <field name="department_id" ref="distribution_core.demo_dept_procurement"/>
    <field name="cost_center">MAL-PROC</field>
    <field name="vendor_id" ref="distribution_core.demo_vendor"/>
    <field name="commitment_type">hybrid</field>
    <field name="start_date" eval="DateTime.today().replace(day=1).strftime('%Y-%m-%d')"/>
    <field name="end_date" eval="(DateTime.today().replace(day=1) + relativedelta(months=3) - timedelta(days=1)).strftime('%Y-%m-%d')"/>
    <field name="committed_value">3193000</field>
    <field name="amount">3193000</field>
    <field name="submission_note">Quarterly volume commitment to secure the 2% volume rebate.</field>
  </record>
  <record id="demo_pc_coastal_quarter_cola" model="purchase.commitment.line">
    <field name="commitment_id" ref="demo_pc_coastal_quarter"/>
    <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('distribution_core.demo_product_cola_rgb'))]"/>
    <field name="committed_qty">2000</field>
    <field name="unit_price">950</field>
  </record>
  <record id="demo_pc_coastal_quarter_orange" model="purchase.commitment.line">
    <field name="commitment_id" ref="demo_pc_coastal_quarter"/>
    <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('distribution_core.demo_product_orange_pet'))]"/>
    <field name="committed_qty">1000</field>
    <field name="unit_price">780</field>
  </record>
  <record id="demo_pc_coastal_quarter_energy" model="purchase.commitment.line">
    <field name="commitment_id" ref="demo_pc_coastal_quarter"/>
    <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('distribution_core.demo_product_energy_can'))]"/>
    <field name="committed_qty">270</field>
    <field name="unit_price">1900</field>
  </record>

  <!-- Water commitment (standard value): submitted and past its 24-hour target -->
  <record id="demo_pc_water_quarter" model="purchase.commitment" uid="distribution_core.demo_user_initiator">
    <field name="department_id" ref="distribution_core.demo_dept_procurement"/>
    <field name="cost_center">MAL-PROC</field>
    <field name="vendor_id" ref="distribution_core.demo_vendor_water"/>
    <field name="commitment_type">quantity</field>
    <field name="start_date" eval="DateTime.today().replace(day=1).strftime('%Y-%m-%d')"/>
    <field name="end_date" eval="(DateTime.today().replace(day=1) + relativedelta(months=3) - timedelta(days=1)).strftime('%Y-%m-%d')"/>
    <field name="committed_value">560000</field>
    <field name="amount">560000</field>
  </record>
  <record id="demo_pc_water_quarter_water" model="purchase.commitment.line">
    <field name="commitment_id" ref="demo_pc_water_quarter"/>
    <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('distribution_core.demo_product_water_pet'))]"/>
    <field name="committed_qty">800</field>
    <field name="unit_price">700</field>
  </record>

  <!-- Energy drink launch stock: reviewed, waiting for final approval -->
  <record id="demo_pc_energy_launch" model="purchase.commitment" uid="distribution_core.demo_user_initiator">
    <field name="department_id" ref="distribution_core.demo_dept_procurement"/>
    <field name="cost_center">MAL-PROC</field>
    <field name="vendor_id" ref="distribution_core.demo_vendor"/>
    <field name="commitment_type">quantity</field>
    <field name="start_date" eval="DateTime.today().replace(day=1).strftime('%Y-%m-%d')"/>
    <field name="end_date" eval="(DateTime.today().replace(day=1) + relativedelta(months=2) - timedelta(days=1)).strftime('%Y-%m-%d')"/>
    <field name="committed_value">760000</field>
    <field name="amount">760000</field>
  </record>
  <record id="demo_pc_energy_launch_energy" model="purchase.commitment.line">
    <field name="commitment_id" ref="demo_pc_energy_launch"/>
    <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('distribution_core.demo_product_energy_can'))]"/>
    <field name="committed_qty">400</field>
    <field name="unit_price">1900</field>
  </record>

  <!-- Extra cola volume (high value): rejected by the senior approver -->
  <record id="demo_pc_cola_top_up" model="purchase.commitment" uid="distribution_core.demo_user_initiator">
    <field name="department_id" ref="distribution_core.demo_dept_procurement"/>
    <field name="cost_center">MAL-PROC</field>
    <field name="vendor_id" ref="distribution_core.demo_vendor"/>
    <field name="commitment_type">value</field>
    <field name="start_date" eval="DateTime.today().replace(day=1).strftime('%Y-%m-%d')"/>
    <field name="end_date" eval="(DateTime.today().replace(day=1) + relativedelta(months=1) - timedelta(days=1)).strftime('%Y-%m-%d')"/>
    <field name="committed_value">1425000</field>
    <field name="amount">1425000</field>
  </record>
  <record id="demo_pc_cola_top_up_cola" model="purchase.commitment.line">
    <field name="commitment_id" ref="demo_pc_cola_top_up"/>
    <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('distribution_core.demo_product_cola_rgb'))]"/>
    <field name="committed_qty">1500</field>
    <field name="unit_price">950</field>
  </record>

  <!-- Next quarter, in draft -->
  <record id="demo_pc_next_quarter" model="purchase.commitment" uid="distribution_core.demo_user_initiator">
    <field name="department_id" ref="distribution_core.demo_dept_procurement"/>
    <field name="cost_center">MAL-PROC</field>
    <field name="vendor_id" ref="distribution_core.demo_vendor"/>
    <field name="commitment_type">hybrid</field>
    <field name="start_date" eval="(DateTime.today().replace(day=1) + relativedelta(months=3)).strftime('%Y-%m-%d')"/>
    <field name="end_date" eval="(DateTime.today().replace(day=1) + relativedelta(months=6) - timedelta(days=1)).strftime('%Y-%m-%d')"/>
    <field name="committed_value">2850000</field>
    <field name="amount">2850000</field>
  </record>
  <record id="demo_pc_next_quarter_cola" model="purchase.commitment.line">
    <field name="commitment_id" ref="demo_pc_next_quarter"/>
    <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('distribution_core.demo_product_cola_rgb'))]"/>
    <field name="committed_qty">3000</field>
    <field name="unit_price">950</field>
  </record>

  <!-- Workflow -->
  <function model="purchase.commitment" name="action_submit" eval="[[ref('demo_pc_coastal_quarter'), ref('demo_pc_water_quarter'), ref('demo_pc_energy_launch'), ref('demo_pc_cola_top_up')]]" uid="distribution_core.demo_user_initiator"/>
  <!-- High value (1M and above, Procurement): approver reviews, senior approver signs off -->
  <function model="purchase.commitment" name="action_review" eval="[[ref('demo_pc_coastal_quarter'), ref('demo_pc_cola_top_up')]]" uid="distribution_core.demo_user_approver"/>
  <function model="purchase.commitment" name="action_approve" eval="[[ref('demo_pc_coastal_quarter')]]" uid="workflow_approval.demo_user_senior_approver"/>
  <function model="purchase.commitment" name="action_start_processing" eval="[[ref('demo_pc_coastal_quarter')]]" uid="workflow_approval.demo_user_senior_approver"/>
  <function model="purchase.commitment" name="write" eval="[[ref('demo_pc_cola_top_up')], {'action_reason': 'Warehouse capacity cannot absorb additional cola volume this month. Resubmit against next quarter.'}]"/>
  <function model="purchase.commitment" name="action_reject" eval="[[ref('demo_pc_cola_top_up')]]" uid="workflow_approval.demo_user_senior_approver"/>
  <!-- Standard value: reviewer, then approver -->
  <function model="purchase.commitment" name="action_review" eval="[[ref('demo_pc_energy_launch')]]" uid="distribution_core.demo_user_reviewer"/>
  <function model="purchase.commitment" name="write" eval="[[ref('demo_pc_water_quarter')], {'submitted_at': (DateTime.now() - timedelta(hours=30)).strftime('%Y-%m-%d %H:%M:%S')}]"/>

  <!-- First call-off against the approved commitment, converted to a purchase order -->
  <record id="demo_pc_coastal_calloff_1" model="purchase.calloff">
    <field name="commitment_id" ref="demo_pc_coastal_quarter"/>
    <field name="warehouse_id" ref="stock.warehouse0"/>
  </record>
  <record id="demo_pc_coastal_calloff_1_cola" model="purchase.calloff.line">
    <field name="calloff_id" ref="demo_pc_coastal_calloff_1"/>
    <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('distribution_core.demo_product_cola_rgb'))]"/>
    <field name="quantity">500</field>
    <field name="unit_price">950</field>
  </record>
  <record id="demo_pc_coastal_calloff_1_orange" model="purchase.calloff.line">
    <field name="calloff_id" ref="demo_pc_coastal_calloff_1"/>
    <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('distribution_core.demo_product_orange_pet'))]"/>
    <field name="quantity">200</field>
    <field name="unit_price">780</field>
  </record>
  <function model="purchase.calloff" name="action_create_po" eval="[[ref('demo_pc_coastal_calloff_1')]]"/>

  <!-- Second call-off, still in draft -->
  <record id="demo_pc_coastal_calloff_2" model="purchase.calloff">
    <field name="commitment_id" ref="demo_pc_coastal_quarter"/>
    <field name="warehouse_id" ref="stock.warehouse0"/>
    <field name="requested_date" eval="(DateTime.today() + timedelta(days=14)).strftime('%Y-%m-%d')"/>
  </record>
  <record id="demo_pc_coastal_calloff_2_energy" model="purchase.calloff.line">
    <field name="calloff_id" ref="demo_pc_coastal_calloff_2"/>
    <field name="product_id" model="product.product" search="[('product_tmpl_id', '=', ref('distribution_core.demo_product_energy_can'))]"/>
    <field name="quantity">120</field>
    <field name="unit_price">1900</field>
  </record>
</odoo>
