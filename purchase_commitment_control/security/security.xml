<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_purchase_commitment_control" model="ir.module.category">
    <field name="name">Broadspace / Purchase Commitments</field>
    <field name="sequence">55</field>
  </record>
  <record id="privilege_module_category_purchase_commitment_control" model="res.groups.privilege">
    <field name="name">Broadspace / Purchase Commitments</field>
    <field name="category_id" ref="module_category_purchase_commitment_control" />
  </record>
  <record id="group_purchase_commitment_control_user" model="res.groups">
    <field name="name">User / Initiator</field>
    <field name="privilege_id" ref="privilege_module_category_purchase_commitment_control" />
  </record>
  <record id="group_purchase_commitment_control_reviewer" model="res.groups">
    <field name="name">Reviewer</field>
    <field name="privilege_id" ref="privilege_module_category_purchase_commitment_control" />
    <field name="implied_ids" eval="[(4, ref('group_purchase_commitment_control_user'))]" />
  </record>
  <record id="group_purchase_commitment_control_approver" model="res.groups">
    <field name="name">Final Approver</field>
    <field name="privilege_id" ref="privilege_module_category_purchase_commitment_control" />
    <field name="implied_ids" eval="[(4, ref('group_purchase_commitment_control_reviewer'))]" />
  </record>
  <record id="group_purchase_commitment_control_manager" model="res.groups">
    <field name="name">Manager / Administrator</field>
    <field name="privilege_id" ref="privilege_module_category_purchase_commitment_control" />
    <field name="implied_ids" eval="[(4, ref('group_purchase_commitment_control_approver'))]" />
  </record>
</odoo>