<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_sales_commission" model="ir.module.category">
    <field name="name">Broadspace / Sales Commissions</field>
    <field name="sequence">55</field>
  </record>
  <record id="privilege_module_category_sales_commission" model="res.groups.privilege">
    <field name="name">Broadspace / Sales Commissions</field>
    <field name="category_id" ref="module_category_sales_commission" />
  </record>
  <record id="group_sales_commission_user" model="res.groups">
    <field name="name">User / Initiator</field>
    <field name="privilege_id" ref="privilege_module_category_sales_commission" />
  </record>
  <record id="group_sales_commission_reviewer" model="res.groups">
    <field name="name">Reviewer</field>
    <field name="privilege_id" ref="privilege_module_category_sales_commission" />
    <field name="implied_ids" eval="[(4, ref('group_sales_commission_user'))]" />
  </record>
  <record id="group_sales_commission_approver" model="res.groups">
    <field name="name">Final Approver</field>
    <field name="privilege_id" ref="privilege_module_category_sales_commission" />
    <field name="implied_ids" eval="[(4, ref('group_sales_commission_reviewer'))]" />
  </record>
  <record id="group_sales_commission_manager" model="res.groups">
    <field name="name">Manager / Administrator</field>
    <field name="privilege_id" ref="privilege_module_category_sales_commission" />
    <field name="implied_ids" eval="[(4, ref('group_sales_commission_approver'))]" />
  </record>
</odoo>