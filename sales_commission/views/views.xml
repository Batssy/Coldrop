<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_sales_commission_list" model="ir.ui.view">
    <field name="name">sales.commission.batch.list</field>
    <field name="model">sales.commission.batch</field>
    <field name="arch" type="xml">
      <list decoration-warning="state == 'submitted'" decoration-success="state == 'closed'">
        <field name="name" />
        <field name="state" />
        <field name="period_start" />
        <field name="period_end" />
        <field name="total_commission" />
      </list>
    </field>
  </record>
  <record id="view_sales_commission_form" model="ir.ui.view">
    <field name="name">sales.commission.batch.form</field>
    <field name="model">sales.commission.batch</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state not in ('draft','correction')" />
          <button name="action_review" type="object" string="Review" class="btn-primary" invisible="state != 'submitted'" />
          <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'reviewed'" />
          <button name="action_return_correction" type="object" string="Return" invisible="state not in ('submitted','reviewed')" />
          <button name="action_reject" type="object" string="Reject" invisible="state not in ('submitted','reviewed')" />
          <button name="action_start_processing" type="object" string="Start Processing" invisible="state != 'approved'" />
          <button name="action_generate_lines" type="object" string="Generate from Sales" groups="sales_commission.group_sales_commission_manager" invisible="state not in ('draft','correction')" />
          <button name="action_reconcile" type="object" string="Reconcile" invisible="state != 'processing'" />
          <button name="action_close" type="object" string="Close" invisible="state not in ('approved','processing','reconciled')" />
          <button name="action_open_reopen_wizard" type="object" string="Reopen / Reset" groups="workflow_approval.group_workflow_manager" invisible="state == 'draft'" />
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,reviewed,approved,processing,reconciled,closed" />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button type="object" name="action_view_events" class="oe_stat_button" icon="fa-history">
              <field name="event_count" widget="statinfo" string="Approval Events" />
            </button>
          </div>
          <div class="oe_title">
            <label for="name" />
            <h1>
              <field name="name" readonly="1" />
            </h1>
          </div>
          <group>
            <group>
              <field name="process_date" />
              <field name="company_id" groups="base.group_multi_company" />
              <field name="region_id" />
              <field name="site_id" />
              <field name="warehouse_id" />
            </group>
            <group>
              <field name="initiator_id" />
              <field name="department_id" />
              <field name="reviewer_id" />
              <field name="final_approver_id" />
              <field name="amount" />
            </group>
          </group>
          <group string="Period">
            <field name="period_start" />
            <field name="period_end" />
            <field name="total_commission" />
          </group>
          <field name="line_ids">
            <list editable="bottom">
              <field name="salesperson_id" />
              <field name="plan_id" />
              <field name="sale_order_id" />
              <field name="product_id" />
              <field name="basis" />
              <field name="quantity" />
              <field name="source_amount" />
              <field name="rate_type" />
              <field name="rate" />
              <field name="adjustment_amount" />
              <field name="commission_amount" />
              <field name="calculation_note" optional="hide" />
            </list>
          </field>
          <notebook>
            <page string="Approval">
              <group>
                <field name="submission_note" readonly="state not in ('draft','correction')" />
                <field name="review_note" readonly="state != 'submitted'" />
                <field name="approval_note" readonly="state != 'reviewed'" />
                <field name="action_reason" placeholder="Required for rejection or return for correction" />
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>
  <record id="view_sales_commission_search" model="ir.ui.view">
    <field name="name">sales.commission.batch.search</field>
    <field name="model">sales.commission.batch</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="state" />
        <field name="site_id" />
        <field name="initiator_id" />
        <filter name="my_reviews" string="Awaiting My Review" domain="[('state','=','submitted'),('reviewer_id','=',uid)]" />
        <filter name="my_approvals" string="Awaiting My Approval" domain="[('state','=','reviewed'),('final_approver_id','=',uid)]" />
        <filter name="my_requests" string="My Requests" domain="[('initiator_id','=',uid)]" />
        <filter string="State" name="group_state" context="{'group_by':'state'}" />
        <filter string="Site" name="group_site" context="{'group_by':'site_id'}" />
      </search>
    </field>
  </record>
  <record id="view_sales_commission_graph" model="ir.ui.view">
    <field name="name">sales.commission.batch.graph</field>
    <field name="model">sales.commission.batch</field>
    <field name="arch" type="xml">
      <graph string="Sales Commissions">
        <field name="state" />
        <field name="total_commission" type="measure" />
      </graph>
    </field>
  </record>
  <record id="view_sales_commission_pivot" model="ir.ui.view">
    <field name="name">sales.commission.batch.pivot</field>
    <field name="model">sales.commission.batch</field>
    <field name="arch" type="xml">
      <pivot string="Sales Commissions">
        <field name="site_id" type="row" />
        <field name="state" type="col" />
        <field name="total_commission" type="measure" />
      </pivot>
    </field>
  </record>
  <record id="action_sales_commission" model="ir.actions.act_window">
    <field name="name">Sales Commissions</field>
    <field name="res_model">sales.commission.batch</field>
    <field name="view_mode">list,form,graph,pivot</field>
  </record>
  <record id="action_sales_commission_my_actions" model="ir.actions.act_window">
    <field name="name">My Actions</field>
    <field name="res_model">sales.commission.batch</field>
    <field name="view_mode">list,form</field>
    <field name="domain">['|',('reviewer_id','=',uid),('final_approver_id','=',uid)]</field>
  </record>
  <record id="view_sales_commission_plan_list" model="ir.ui.view"><field name="name">sales.commission.plan.list</field><field name="model">sales.commission.plan</field><field name="arch" type="xml"><list><field name="sequence"/><field name="name"/><field name="basis"/><field name="employment_type"/><field name="rate_type"/><field name="rate"/><field name="target_amount"/><field name="minimum_achievement_percent"/><field name="active"/></list></field></record>
  <record id="view_sales_commission_plan_form" model="ir.ui.view"><field name="name">sales.commission.plan.form</field><field name="model">sales.commission.plan</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="active"/><field name="sequence"/><field name="company_id"/><field name="date_start"/><field name="date_end"/><field name="salesperson_ids" widget="many2many_tags"/><field name="employment_type"/></group><group><field name="basis"/><field name="rate_type"/><field name="rate"/><field name="product_id"/><field name="product_category_id"/><field name="target_amount"/><field name="minimum_achievement_percent"/><field name="cap_amount"/><field name="include_refund_clawback"/></group></group></sheet></form></field></record>
  <record id="action_sales_commission_plans" model="ir.actions.act_window"><field name="name">Commission Plans</field><field name="res_model">sales.commission.plan</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_sales_commission_root" name="Sales Commissions" sequence="30" groups="sales_commission.group_sales_commission_user" />
  <menuitem id="menu_sales_commission_dashboard" parent="menu_sales_commission_root" name="Dashboard / Analysis" action="action_sales_commission" sequence="5" />
  <menuitem id="menu_sales_commission_transactions" parent="menu_sales_commission_root" name="Transactions" action="action_sales_commission" sequence="10" />
  <menuitem id="menu_sales_commission_my_actions" parent="menu_sales_commission_root" name="My Actions" action="action_sales_commission_my_actions" sequence="20" />
  <menuitem id="menu_sales_commission_plans" parent="menu_sales_commission_root" name="Commission Plans" action="action_sales_commission_plans" sequence="30" groups="sales_commission.group_sales_commission_manager" />
</odoo>
