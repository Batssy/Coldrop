<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_workflow" model="ir.module.category">
    <field name="name">Broadspace / Workflow and Approvals</field>
    <field name="sequence">55</field>
  </record>
  <record id="privilege_module_category_workflow" model="res.groups.privilege">
    <field name="name">Broadspace / Workflow and Approvals</field>
    <field name="category_id" ref="module_category_workflow" />
  </record>
  <record id="group_workflow_user" model="res.groups">
    <field name="name">User / Initiator</field>
    <field name="privilege_id" ref="privilege_module_category_workflow" />
  </record>
  <record id="group_workflow_reviewer" model="res.groups">
    <field name="name">Reviewer</field>
    <field name="privilege_id" ref="privilege_module_category_workflow" />
    <field name="implied_ids" eval="[(4, ref('group_workflow_user'))]" />
  </record>
  <record id="group_workflow_approver" model="res.groups">
    <field name="name">Final Approver</field>
    <field name="privilege_id" ref="privilege_module_category_workflow" />
    <field name="implied_ids" eval="[(4, ref('group_workflow_reviewer'))]" />
  </record>
  <record id="group_workflow_manager" model="res.groups">
    <field name="name">Manager / Administrator</field>
    <field name="privilege_id" ref="privilege_module_category_workflow" />
    <field name="implied_ids" eval="[(4, ref('group_workflow_approver'))]" />
  </record>
</odoo>
