    <field name="process_key">budget_close</field>
    <field name="reviewer_id" ref="distribution_core.demo_user_approver"/>
    <field name="final_approver_id" ref="demo_user_senior_approver"/>
    <field name="escalation_user_id" ref="demo_user_workflow_manager"/>
    <field name="approval_hours">72</field>
  </record>

  <!-- Cash collections: tighter turnaround -->
  <record id="demo_matrix_cash_collection" model="distribution.approval.matrix">
    <field name="name">Demo Cash Collection Approval</field>
    <field name="process_key">cash_collection</field>
