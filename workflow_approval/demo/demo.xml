<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <!-- Workflow roles for the shared distribution_core demo users -->
  <record id="distribution_core.demo_user_initiator" model="res.users">
    <field name="group_ids" eval="[(4, ref('workflow_approval.group_workflow_user'))]"/>
  </record>
  <record id="distribution_core.demo_user_reviewer" model="res.users">
    <field name="group_ids" eval="[(4, ref('workflow_approval.group_workflow_reviewer'))]"/>
  </record>
  <record id="distribution_core.demo_user_approver" model="res.users">
    <field name="group_ids" eval="[(4, ref('workflow_approval.group_workflow_approver'))]"/>
  </record>
  <record id="distribution_core.demo_user_executive" model="res.users">
    <field name="group_ids" eval="[(4, ref('workflow_approval.group_workflow_user'))]"/>
  </record>

  <!-- Additional approvers for high-value tiers and escalation -->
  <record id="demo_user_senior_approver" model="res.users">
    <field name="name">Demo Senior Approver</field>
    <field name="login">demo.distribution.senior.approver</field>
    <field name="email">senior.approver@example.com</field>
    <field name="group_ids" eval="[(4, ref('base.group_user')), (4, ref('distribution_core.group_distribution_core_approver')), (4, ref('workflow_approval.group_workflow_approver'))]"/>
  </record>
  <record id="demo_user_workflow_manager" model="res.users">
    <field name="name">Demo Workflow Manager</field>
    <field name="login">demo.distribution.workflow.manager</field>
    <field name="email">workflow.manager@example.com</field>
    <field name="group_ids" eval="[(4, ref('base.group_user')), (4, ref('distribution_core.group_distribution_core_approver')), (4, ref('workflow_approval.group_workflow_manager'))]"/>
  </record>

  <!-- Sales commitments: department-specific standard tier, plus a high-value tier -->
  <record id="demo_matrix_sales_commitment" model="distribution.approval.matrix">
    <field name="name">Demo Sales Commitment Approval</field>
    <field name="process_key">sales_commitment</field>
    <field name="department_id" ref="distribution_core.demo_dept_sales"/>
    <field name="min_amount">0</field>
    <field name="max_amount">500000</field>
    <field name="reviewer_id" ref="distribution_core.demo_user_reviewer"/>
    <field name="final_approver_id" ref="distribution_core.demo_user_approver"/>
    <field name="escalation_user_id" ref="demo_user_workflow_manager"/>
    <field name="approval_hours">24</field>
  </record>
  <record id="demo_matrix_sales_commitment_high" model="distribution.approval.matrix">
    <field name="name">Demo Sales Commitment Approval (High Value)</field>
    <field name="process_key">sales_commitment</field>
    <field name="min_amount">500000</field>
    <field name="reviewer_id" ref="distribution_core.demo_user_approver"/>
    <field name="final_approver_id" ref="demo_user_senior_approver"/>
    <field name="escalation_user_id" ref="demo_user_workflow_manager"/>
    <field name="approval_hours">12</field>
  </record>

  <!-- Purchase commitments -->
  <record id="demo_matrix_purchase_commitment" model="distribution.approval.matrix">
    <field name="name">Demo Purchase Commitment Approval</field>
    <field name="process_key">purchase_commitment</field>
    <field name="min_amount">0</field>
    <field name="max_amount">1000000</field>
    <field name="reviewer_id" ref="distribution_core.demo_user_reviewer"/>
    <field name="final_approver_id" ref="distribution_core.demo_user_approver"/>
    <field name="escalation_user_id" ref="demo_user_workflow_manager"/>
    <field name="approval_hours">24</field>
  </record>
  <record id="demo_matrix_purchase_commitment_high" model="distribution.approval.matrix">
    <field name="name">Demo Purchase Commitment Approval (High Value)</field>
    <field name="process_key">purchase_commitment</field>
    <field name="department_id" ref="distribution_core.demo_dept_procurement"/>
    <field name="min_amount">1000000</field>
    <field name="reviewer_id" ref="distribution_core.demo_user_approver"/>
    <field name="final_approver_id" ref="demo_user_senior_approver"/>
    <field name="escalation_user_id" ref="demo_user_workflow_manager"/>
    <field name="approval_hours">12</field>
  </record>

  <!-- Credit applications -->
  <record id="demo_matrix_credit" model="distribution.approval.matrix">
    <field name="name">Demo Credit Approval</field>
    <field name="process_key">credit_application</field>
    <field name="min_amount">0</field>
    <field name="max_amount">250000</field>
    <field name="reviewer_id" ref="distribution_core.demo_user_reviewer"/>
    <field name="final_approver_id" ref="distribution_core.demo_user_approver"/>
    <field name="approval_hours">48</field>
  </record>
  <record id="demo_matrix_credit_high" model="distribution.approval.matrix">
    <field name="name">Demo Credit Approval (High Limit)</field>
    <field name="process_key">credit_application</field>
    <field name="department_id" ref="distribution_core.demo_dept_finance"/>
