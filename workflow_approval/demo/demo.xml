    <field name="process_key">commission</field>
    <field name="department_id" ref="distribution_core.demo_dept_finance"/>
    <field name="reviewer_id" ref="distribution_core.demo_user_approver"/>
    <field name="final_approver_id" ref="demo_user_senior_approver"/>
    <field name="approval_hours">48</field>
  </record>
  <record id="demo_matrix_site_access" model="distribution.approval.matrix">
    <field name="name">Demo Site Access Approval</field>
    <field name="process_key">site_access</field>
    <field name="site_id" ref="distribution_core.demo_site_malindi"/>
