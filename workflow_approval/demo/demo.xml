  <record id="demo_matrix_returnables" model="distribution.approval.matrix">
    <field name="name">Demo Returnables Approval</field>
    <field name="process_key">returnables</field>
    <field name="reviewer_id" ref="distribution_core.demo_user_reviewer"/>
    <field name="final_approver_id" ref="distribution_core.demo_user_approver"/>
    <field name="approval_hours">24</field>
  </record>
  <record id="demo_matrix_product_return" model="distribution.approval.matrix">
    <field name="name">Demo Product Return Approval</field>
    <field name="process_key">product_return</field>
    <field name="reviewer_id" ref="distribution_core.demo_user_reviewer"/>
