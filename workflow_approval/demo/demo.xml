  <!-- Archived rule, to show that inactive matrices are ignored during routing -->
  <record id="demo_matrix_sales_commitment_legacy" model="distribution.approval.matrix">
    <field name="name">Demo Sales Commitment Approval (Legacy, Archived)</field>
    <field name="process_key">sales_commitment</field>
    <field name="active" eval="False"/>
    <field name="reviewer_id" ref="distribution_core.demo_user_reviewer"/>
    <field name="final_approver_id" ref="distribution_core.demo_user_reviewer"/>
    <field name="approval_hours">72</field>
  </record>
