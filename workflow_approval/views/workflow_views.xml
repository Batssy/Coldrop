<odoo>
<record id="view_approval_matrix_list" model="ir.ui.view"><field name="name">distribution.approval.matrix.list</field><field name="model">distribution.approval.matrix</field><field name="arch" type="xml"><list><field name="name"/><field name="process_key"/><field name="department_id"/><field name="site_id"/><field name="min_amount"/><field name="reviewer_id"/><field name="final_approver_id"/><field name="approval_hours"/></list></field></record>
<record id="view_approval_matrix_form" model="ir.ui.view"><field name="name">distribution.approval.matrix.form</field><field name="model">distribution.approval.matrix</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="process_key"/><field name="company_id"/><field name="department_id"/><field name="site_id"/></group><group><field name="min_amount"/><field name="max_amount"/><field name="reviewer_id"/><field name="final_approver_id"/><field name="escalation_user_id"/><field name="approval_hours"/></group></group></sheet></form></field></record>
<record id="view_workflow_event_list" model="ir.ui.view"><field name="name">distribution.workflow.event.list</field><field name="model">distribution.workflow.event</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="event_at"/><field name="document_name"/><field name="action"/><field name="from_state"/><field name="to_state"/><field name="user_id"/><field name="site_id"/><field name="note"/></list></field></record>
<record id="view_workflow_reopen_wizard_form" model="ir.ui.view"><field name="name">distribution.workflow.reopen.wizard.form</field><field name="model">distribution.workflow.reopen.wizard</field><field name="arch" type="xml"><form string="Reopen Controlled Record"><group><field name="document_model"/><field name="document_id"/><field name="target"/><field name="reason" placeholder="Mandatory business reason"/><field name="downstream_acknowledged"/></group><footer><button name="action_confirm" type="object" string="Reopen" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
<record id="action_approval_matrix" model="ir.actions.act_window"><field name="name">Approval Matrix</field><field name="res_model">distribution.approval.matrix</field><field name="view_mode">list,form</field></record>
<record id="action_workflow_events" model="ir.actions.act_window"><field name="name">Workflow Audit Log</field><field name="res_model">distribution.workflow.event</field><field name="view_mode">list,form</field><field name="context">{'create': False}</field></record>
<menuitem id="menu_workflow_root" name="Workflow &amp; Approvals" sequence="15" groups="workflow_approval.group_workflow_user"/>
<menuitem id="menu_workflow_my_actions" parent="menu_workflow_root" name="Approval Matrix" action="action_approval_matrix" sequence="20" groups="workflow_approval.group_workflow_manager"/>
<menuitem id="menu_workflow_audit" parent="menu_workflow_root" name="Audit Log" action="action_workflow_events" sequence="30"/>
</odoo>
