<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_distribution_core" model="ir.module.category">
    <field name="name">Broadspace / Distribution Configuration</field>
    <field name="sequence">55</field>
  </record>
  <record id="privilege_module_category_distribution_core" model="res.groups.privilege">
    <field name="name">Broadspace / Distribution Configuration</field>
    <field name="category_id" ref="module_category_distribution_core" />
  </record>
  <record id="group_distribution_core_user" model="res.groups">
    <field name="name">User / Initiator</field>
    <field name="privilege_id" ref="privilege_module_category_distribution_core" />
  </record>
  <record id="group_distribution_core_reviewer" model="res.groups">
    <field name="name">Reviewer</field>
    <field name="privilege_id" ref="privilege_module_category_distribution_core" />
    <field name="implied_ids" eval="[(4, ref('group_distribution_core_user'))]" />
  </record>
  <record id="group_distribution_core_approver" model="res.groups">
    <field name="name">Final Approver</field>
    <field name="privilege_id" ref="privilege_module_category_distribution_core" />
    <field name="implied_ids" eval="[(4, ref('group_distribution_core_reviewer'))]" />
  </record>
  <record id="group_distribution_core_manager" model="res.groups">
    <field name="name">Manager / Administrator</field>
    <field name="privilege_id" ref="privilege_module_category_distribution_core" />
    <field name="implied_ids" eval="[(4, ref('group_distribution_core_approver'))]" />
  </record>
</odoo>