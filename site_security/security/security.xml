<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_site_security" model="ir.module.category">
    <field name="name">Broadspace / Site and Security</field>
    <field name="sequence">55</field>
  </record>
  <record id="privilege_module_category_site_security" model="res.groups.privilege">
    <field name="name">Broadspace / Site and Security</field>
    <field name="category_id" ref="module_category_site_security" />
  </record>
  <record id="group_site_security_user" model="res.groups">
    <field name="name">User / Initiator</field>
    <field name="privilege_id" ref="privilege_module_category_site_security" />
  </record>
  <record id="group_site_security_reviewer" model="res.groups">
    <field name="name">Reviewer</field>
    <field name="privilege_id" ref="privilege_module_category_site_security" />
    <field name="implied_ids" eval="[(4, ref('group_site_security_user'))]" />
  </record>
  <record id="group_site_security_approver" model="res.groups">
    <field name="name">Final Approver</field>
    <field name="privilege_id" ref="privilege_module_category_site_security" />
    <field name="implied_ids" eval="[(4, ref('group_site_security_reviewer'))]" />
  </record>
  <record id="group_site_security_manager" model="res.groups">
    <field name="name">Manager / Administrator</field>
    <field name="privilege_id" ref="privilege_module_category_site_security" />
    <field name="implied_ids" eval="[(4, ref('group_site_security_approver'))]" />
  </record>
</odoo>
