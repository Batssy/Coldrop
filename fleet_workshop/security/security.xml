<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_fleet_workshop" model="ir.module.category">
    <field name="name">Broadspace / Fleet Workshop</field>
    <field name="sequence">55</field>
  </record>
  <record id="privilege_module_category_fleet_workshop" model="res.groups.privilege">
    <field name="name">Broadspace / Fleet Workshop</field>
    <field name="category_id" ref="module_category_fleet_workshop" />
  </record>
  <record id="group_fleet_workshop_user" model="res.groups">
    <field name="name">User / Initiator</field>
    <field name="privilege_id" ref="privilege_module_category_fleet_workshop" />
  </record>
  <record id="group_fleet_workshop_reviewer" model="res.groups">
    <field name="name">Reviewer</field>
    <field name="privilege_id" ref="privilege_module_category_fleet_workshop" />
    <field name="implied_ids" eval="[(4, ref('group_fleet_workshop_user'))]" />
  </record>
  <record id="group_fleet_workshop_approver" model="res.groups">
    <field name="name">Final Approver</field>
    <field name="privilege_id" ref="privilege_module_category_fleet_workshop" />
    <field name="implied_ids" eval="[(4, ref('group_fleet_workshop_reviewer'))]" />
  </record>
  <record id="group_fleet_workshop_manager" model="res.groups">
    <field name="name">Manager / Administrator</field>
    <field name="privilege_id" ref="privilege_module_category_fleet_workshop" />
    <field name="implied_ids" eval="[(4, ref('group_fleet_workshop_approver'))]" />
  </record>
</odoo>