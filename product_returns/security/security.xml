<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_product_returns" model="ir.module.category">
    <field name="name">Broadspace / Product Returns</field>
    <field name="sequence">55</field>
  </record>
  <record id="privilege_module_category_product_returns" model="res.groups.privilege">
    <field name="name">Broadspace / Product Returns</field>
    <field name="category_id" ref="module_category_product_returns" />
  </record>
  <record id="group_product_returns_user" model="res.groups">
    <field name="name">User / Initiator</field>
    <field name="privilege_id" ref="privilege_module_category_product_returns" />
  </record>
  <record id="group_product_returns_reviewer" model="res.groups">
    <field name="name">Reviewer</field>
    <field name="privilege_id" ref="privilege_module_category_product_returns" />
    <field name="implied_ids" eval="[(4, ref('group_product_returns_user'))]" />
  </record>
  <record id="group_product_returns_approver" model="res.groups">
    <field name="name">Final Approver</field>
    <field name="privilege_id" ref="privilege_module_category_product_returns" />
    <field name="implied_ids" eval="[(4, ref('group_product_returns_reviewer'))]" />
  </record>
  <record id="group_product_returns_manager" model="res.groups">
    <field name="name">Manager / Administrator</field>
    <field name="privilege_id" ref="privilege_module_category_product_returns" />
    <field name="implied_ids" eval="[(4, ref('group_product_returns_approver'))]" />
  </record>
</odoo>