<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <!-- Access for the demo users -->
  <record id="distribution_core.demo_user_initiator" model="res.users">
    <field name="group_ids" eval="[(4, ref('demand_intelligence.group_demand_intelligence_user'))]"/>
  </record>
  <record id="distribution_core.demo_user_reviewer" model="res.users">
    <field name="group_ids" eval="[(4, ref('demand_intelligence.group_demand_intelligence_reviewer'))]"/>
  </record>
  <record id="distribution_core.demo_user_approver" model="res.users">
    <field name="group_ids" eval="[(4, ref('demand_intelligence.group_demand_intelligence_approver'))]"/>
  </record>
  <record id="workflow_approval.demo_user_workflow_manager" model="res.users">
    <field name="group_ids" eval="[(4, ref('demand_intelligence.group_demand_intelligence_manager'))]"/>
  </record>

  <!-- 30-day forecast for Malindi, generated from sales history, approved commitments, stock and open POs -->
  <record id="demo_forecast_malindi_30" model="demand.forecast">
    <field name="site_id" ref="distribution_core.demo_site_malindi"/>
    <field name="warehouse_id" ref="stock.warehouse0"/>
    <field name="horizon_days">30</field>
  </record>
  <function model="demand.forecast" name="action_generate" eval="[[ref('demo_forecast_malindi_30')]]"/>

  <!-- 90-day planning forecast -->
  <record id="demo_forecast_malindi_90" model="demand.forecast">
    <field name="site_id" ref="distribution_core.demo_site_malindi"/>
    <field name="warehouse_id" ref="stock.warehouse0"/>
    <field name="horizon_days">90</field>
  </record>
  <function model="demand.forecast" name="action_generate" eval="[[ref('demo_forecast_malindi_90')]]"/>
</odoo>
