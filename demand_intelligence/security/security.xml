<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_demand_intelligence" model="ir.module.category">
    <field name="name">Broadspace / Demand Intelligence</field>
    <field name="sequence">55</field>
  </record>
  <record id="privilege_module_category_demand_intelligence" model="res.groups.privilege">
    <field name="name">Broadspace / Demand Intelligence</field>
    <field name="category_id" ref="module_category_demand_intelligence" />
  </record>
  <record id="group_demand_intelligence_user" model="res.groups">
    <field name="name">User / Initiator</field>
    <field name="privilege_id" ref="privilege_module_category_demand_intelligence" />
  </record>
  <record id="group_demand_intelligence_reviewer" model="res.groups">
    <field name="name">Reviewer</field>
    <field name="privilege_id" ref="privilege_module_category_demand_intelligence" />
    <field name="implied_ids" eval="[(4, ref('group_demand_intelligence_user'))]" />
  </record>
  <record id="group_demand_intelligence_approver" model="res.groups">
    <field name="name">Final Approver</field>
    <field name="privilege_id" ref="privilege_module_category_demand_intelligence" />
    <field name="implied_ids" eval="[(4, ref('group_demand_intelligence_reviewer'))]" />
  </record>
  <record id="group_demand_intelligence_manager" model="res.groups">
    <field name="name">Manager / Administrator</field>
    <field name="privilege_id" ref="privilege_module_category_demand_intelligence" />
    <field name="implied_ids" eval="[(4, ref('group_demand_intelligence_approver'))]" />
  </record>
</odoo>